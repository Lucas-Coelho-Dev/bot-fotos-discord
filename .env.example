# Token do Bot do Discord (obtido em https://discord.com/developers/applications)
DISCORD_TOKEN=seu_bot_token_aqui

# ID da Aplicação / Client ID do Bot
DISCORD_CLIENT_ID=seu_client_id_aqui

# ID do Servidor (Guild ID)
DISCORD_GUILD_ID=seu_guild_id_aqui

# ID da Categoria onde os canais particulares dos colaboradores serão criados
DISCORD_CATEGORY_ID=seu_category_id_aqui

# (Opcional) ID de um cargo de Administrador/Gerente para ter acesso aos canais privados
ADMIN_ROLE_ID=

# Porta do servidor Web local (Padrão: 3000)
PORT=3000

# URL Pública fixa (opcional - se vazio, o Cloudflare Tunnel automático gerará a URL HTTPS trycloudflare.com)
PUBLIC_URL=
